# Скопируйте в deploy/.env.local (файл не коммитится)
# Хост и каталоги — из письма HB.BY / ISPmanager

# IP или hostname из панели HB.BY
FTP_HOST=176.60.210.120
FTP_PORT=21
FTP_USER=u41977-8185
FTP_PASSWORD=

# front | api | release (или npm run deploy:ftp:front / deploy:ftp:api)
FTP_MODE=front
# для api (Next standalone + app.js в корень busnow.online)
FTP_API_DIR=/www/busnow.online/backend/.next/standalone/

# Абсолютный путь от корня FTP. Без ведущего / папки вкладываются друг в друга.
FTP_SECURE=1
FTP_PASSIVE=1
FTP_FRONT_DIR=/www/busnow.online/
# root — содержимое dist в корень сайта; appjs — в frontend/dist/ (для node app.js)
FTP_FRONT_LAYOUT=root

SITE_URL=https://busnow.online
